generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrganizationType {
  CHOIR
  PARISH
  OTHER
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ON_LEAVE
  FORMER
}

enum ActivityType {
  REHEARSAL
  MASS
  CONCERT
  MEETING
  TRAINING
  RECOLLECTION
  OUTING
  PERFORMANCE
  OTHER
}

enum ActivityStatus {
  SCHEDULED
  CANCELLED
  POSTPONED
  COMPLETED
}

enum ActivityVisibility {
  ALL_MEMBERS
  LEADERS_ONLY
  TARGETED
}

enum RecurrenceType {
  WEEKLY
  MONTHLY
  CUSTOM
}

enum AttendanceScanType {
  ARRIVAL
  DEPARTURE
}

enum AttendanceStatus {
  PRESENT
  LATE
  SEVERELY_LATE
  ABSENT
}

enum ParticipationStatus {
  PENDING
  COMPLETE
  PARTIAL
  INSUFFICIENT
}

enum NotificationChannel {
  IN_APP
  PUSH
}

enum NotificationTrigger {
  ACTIVITY_REMINDER
  LATE_ARRIVAL
  ACTIVITY_ENDED
  MANUAL
}

enum NotificationJobStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum CurrencyCode {
  CDF
  USD
}

enum FinanceFundType {
  ORDINARY
  ASSISTANCE
  PROJECT
  ACTIVITY
  OTHER
}

enum FinanceContributionFrequency {
  ONCE
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum FinanceTargetType {
  ALL_MEMBERS
  VOICE_SECTIONS
  MEMBERS
}

enum FinancePaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  CARD
  OTHER
}

enum FinanceEntryStatus {
  PENDING
  VALIDATED
  CANCELLED
}

enum FinanceMovementType {
  OPENING_BALANCE
  CONTRIBUTION_PAYMENT
  INCOME
  EXPENSE
  REVERSAL
}

enum SongStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SongDifficulty {
  EASY
  MEDIUM
  HARD
}

enum LiturgicalSeason {
  ADVENT
  CHRISTMAS
  LENT
  EASTER
  ORDINARY_TIME
  OTHER
}

enum SongTrackType {
  SOPRANO
  ALTO
  TENOR
  BASS
  ENSEMBLE
  INSTRUMENTAL
  GUIDE
  OTHER
}

enum MediaVisibility {
  ALL_MEMBERS
  VOICE_SECTION
  LEADERS_ONLY
}

enum SongMasteryStatus {
  TO_DISCOVER
  IN_PROGRESS
  MASTERED
  TO_REVIEW
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum AnnouncementAudienceType {
  ALL_MEMBERS
  VOICE_SECTIONS
  ROLES
  MEMBERS
}

enum AnnouncementTargetType {
  VOICE_SECTION
  ROLE
  MEMBERSHIP
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JustificationKind {
  ABSENCE
  LATE
}

enum JustificationReason {
  ILLNESS
  WORK
  TRAVEL
  FAMILY
  STUDIES
  OTHER
}

enum RsvpAnswer {
  YES
  NO
  MAYBE
}

enum SubscriptionPlanCode {
  FREE
  PRO
  PREMIUM
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum MessagingChannel {
  WHATSAPP
  EMAIL
  SMS
}

enum MessagingProviderCode {
  MOCK
  INFOBIP
  META_CLOUD_API
  OTHER
}

enum MessagingAttemptStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

enum PaymentProviderType {
  MOCK
  MOBILE_MONEY
  BANK
  CARD
  OTHER
}

enum PaymentTransactionStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum OfflineSyncStatus {
  RECEIVED
  APPLIED
  DUPLICATE
  REJECTED
}

enum OfflineEventType {
  ATTENDANCE_SCAN
  PROFILE_UPDATE
  GENERIC
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String?        @unique
  phone         String?        @unique
  passwordHash  String
  firstName     String
  lastName      String
  locale        String         @default("fr")
  status        UserStatus     @default(ACTIVE)
  memberships   Membership[]
  refreshTokens RefreshToken[]
  deviceTokens  DeviceToken[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model Organization {
  id            String                     @id @default(uuid()) @db.Uuid
  name          String
  type          OrganizationType           @default(CHOIR)
  status        EntityStatus               @default(ACTIVE)
  choirs        Choir[]
  roles         Role[]
  subscriptions OrganizationSubscription[]
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@map("organizations")
}

model Choir {
  id                      String                    @id @default(uuid()) @db.Uuid
  organizationId          String                    @db.Uuid
  organization            Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                    String
  slug                    String                    @unique
  timezone                String                    @default("Africa/Kinshasa")
  settings                Json                      @default("{}")
  status                  EntityStatus              @default(ACTIVE)
  memberships             Membership[]
  voiceSections           VoiceSection[]
  pastoralYears           PastoralYear[]
  activitySeries          ActivitySeries[]
  activities              Activity[]
  attendances             Attendance[]
  notificationTemplates   NotificationTemplate[]
  notificationJobs        NotificationJob[]
  financeFunds            FinanceFund[]
  contributions           Contribution[]
  contributionObligations ContributionObligation[]
  contributionPayments    ContributionPayment[]
  financeIncomes          FinanceIncome[]
  financeExpenses         FinanceExpense[]
  financeMovements        FinanceMovement[]
  songs                   Song[]
  songTracks              SongTrack[]
  songRehearsals          SongRehearsal[]
  songMasteries           SongVoiceSectionMastery[]
  massContents            MassContent[]
  massSongbooks           MassSongbook[]
  announcements           Announcement[]
  justifications          Justification[]
  dispensations           Dispensation[]
  rsvpRequests            RsvpRequest[]
  rsvpResponses           RsvpResponse[]
  messagingTemplates      MessagingTemplate[]
  messagingAttempts       MessagingAttempt[]
  paymentTransactions     PaymentTransaction[]
  paymentWebhookEvents    PaymentWebhookEvent[]
  offlineDevices          OfflineDevice[]
  offlineSyncEvents       OfflineSyncEvent[]
  auditLogs               AuditLog[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([organizationId])
  @@map("choirs")
}

model Membership {
  id                            String                    @id @default(uuid()) @db.Uuid
  userId                        String                    @db.Uuid
  choirId                       String                    @db.Uuid
  user                          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  choir                         Choir                     @relation(fields: [choirId], references: [id], onDelete: Cascade)
  status                        MembershipStatus          @default(ACTIVE)
  joinedAt                      DateTime                  @default(now())
  archivedAt                    DateTime?
  profile                       MemberProfile?
  roles                         MembershipRole[]
  sectionAssignments            VoiceSectionAssignment[]
  responsibleActivities         Activity[]                @relation("ActivityResponsible")
  targetedActivities            ActivityTarget[]
  attendances                   Attendance[]
  attendanceQrTokens            AttendanceQrToken[]
  performedScans                AttendanceScan[]          @relation("AttendanceScanner")
  notificationJobs              NotificationJob[]
  inAppNotifications            InAppNotification[]
  contributionTargets           ContributionTarget[]
  contributionObligations       ContributionObligation[]
  contributionPayments          ContributionPayment[]
  validatedContributionPayments ContributionPayment[]     @relation("ContributionPaymentValidator")
  validatedFinanceIncomes       FinanceIncome[]           @relation("FinanceIncomeValidator")
  validatedFinanceExpenses      FinanceExpense[]          @relation("FinanceExpenseValidator")
  createdSongs                  Song[]                    @relation("SongCreator")
  createdSongRehearsals         SongRehearsal[]           @relation("SongRehearsalCreator")
  updatedSongMasteries          SongVoiceSectionMastery[] @relation("SongMasteryUpdater")
  createdMassContents           MassContent[]             @relation("MassContentCreator")
  createdMassSongbooks          MassSongbook[]            @relation("MassSongbookCreator")
  createdAnnouncements          Announcement[]            @relation("AnnouncementCreator")
  announcementTargets           AnnouncementTarget[]
  announcementReads             AnnouncementRead[]
  justifications                Justification[]           @relation("JustificationRequester")
  reviewedJustifications        Justification[]           @relation("JustificationReviewer")
  dispensations                 Dispensation[]            @relation("DispensationRequester")
  reviewedDispensations         Dispensation[]            @relation("DispensationReviewer")
  createdRsvpRequests           RsvpRequest[]             @relation("RsvpRequestCreator")
  rsvpResponses                 RsvpResponse[]
  messagingAttempts             MessagingAttempt[]
  offlineDevices                OfflineDevice[]
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt

  @@unique([userId, choirId])
  @@index([choirId, status])
  @@map("memberships")
}

model PastoralYear {
  id         String     @id @default(uuid()) @db.Uuid
  choirId    String     @db.Uuid
  choir      Choir      @relation(fields: [choirId], references: [id], onDelete: Cascade)
  name       String
  startDate  DateTime   @db.Date
  endDate    DateTime   @db.Date
  isActive   Boolean    @default(false)
  activities Activity[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([choirId, name])
  @@index([choirId, startDate, endDate])
  @@map("pastoral_years")
}

model ActivitySeries {
  id             String         @id @default(uuid()) @db.Uuid
  choirId        String         @db.Uuid
  choir          Choir          @relation(fields: [choirId], references: [id], onDelete: Cascade)
  recurrenceType RecurrenceType
  interval       Int            @default(1)
  daysOfWeek     Int[]          @default([])
  customDates    DateTime[]     @default([])
  until          DateTime
  timezone       String
  activities     Activity[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([choirId])
  @@map("activity_series")
}

model Activity {
  id                      String              @id @default(uuid()) @db.Uuid
  choirId                 String              @db.Uuid
  choir                   Choir               @relation(fields: [choirId], references: [id], onDelete: Cascade)
  pastoralYearId          String?             @db.Uuid
  pastoralYear            PastoralYear?       @relation(fields: [pastoralYearId], references: [id], onDelete: SetNull)
  seriesId                String?             @db.Uuid
  series                  ActivitySeries?     @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  type                    ActivityType
  status                  ActivityStatus      @default(SCHEDULED)
  title                   String
  startsAt                DateTime
  endsAt                  DateTime
  timezone                String
  location                String?
  description             String?
  responsibleMembershipId String?             @db.Uuid
  responsibleMembership   Membership?         @relation("ActivityResponsible", fields: [responsibleMembershipId], references: [id], onDelete: SetNull)
  visibility              ActivityVisibility  @default(ALL_MEMBERS)
  attendanceRequired      Boolean             @default(true)
  reminderOffsetsMinutes  Int[]               @default([])
  cancellationReason      String?
  isSeriesOverride        Boolean             @default(false)
  targets                 ActivityTarget[]
  attendances             Attendance[]
  attendanceQrTokens      AttendanceQrToken[]
  notificationJobs        NotificationJob[]
  songRehearsals          SongRehearsal[]
  massContent             MassContent?
  massSongbooks           MassSongbook[]
  justifications          Justification[]
  rsvpRequest             RsvpRequest?
  rsvpResponses           RsvpResponse[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@unique([seriesId, startsAt])
  @@index([choirId, startsAt])
  @@index([pastoralYearId])
  @@map("activities")
}

model ActivityTarget {
  activityId   String     @db.Uuid
  membershipId String     @db.Uuid
  activity     Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([activityId, membershipId])
  @@map("activity_targets")
}

model VoiceSection {
  id                  String                    @id @default(uuid()) @db.Uuid
  choirId             String                    @db.Uuid
  choir               Choir                     @relation(fields: [choirId], references: [id], onDelete: Cascade)
  name                String
  order               Int                       @default(0)
  profiles            MemberProfile[]
  assignments         VoiceSectionAssignment[]
  contributionTargets ContributionTarget[]
  songTracks          SongTrack[]
  songMasteries       SongVoiceSectionMastery[]
  announcementTargets AnnouncementTarget[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@unique([choirId, name])
  @@map("voice_sections")
}

model MemberProfile {
  membershipId          String        @id @db.Uuid
  membership            Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  postName              String?
  gender                String?
  birthDate             DateTime?     @db.Date
  photoUrl              String?
  voiceSectionId        String?       @db.Uuid
  voiceSection          VoiceSection? @relation(fields: [voiceSectionId], references: [id], onDelete: SetNull)
  joinedChoirAt         DateTime?
  functionTitle         String?
  emergencyContactName  String?
  emergencyContactPhone String?
  whatsappConsentAt     DateTime?
  whatsappConsentSource String?
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@map("member_profiles")
}

model VoiceSectionAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  membershipId   String       @db.Uuid
  voiceSectionId String       @db.Uuid
  membership     Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  voiceSection   VoiceSection @relation(fields: [voiceSectionId], references: [id], onDelete: Restrict)
  startsAt       DateTime     @default(now())
  endsAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([membershipId, startsAt])
  @@map("voice_section_assignments")
}

model Role {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String?              @db.Uuid
  organization        Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                String
  name                String
  isSystem            Boolean              @default(false)
  permissions         RolePermission[]
  memberships         MembershipRole[]
  announcementTargets AnnouncementTarget[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([organizationId, code])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String     @db.Uuid
  roleId       String     @db.Uuid
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Attendance {
  id                  String              @id @default(uuid()) @db.Uuid
  choirId             String              @db.Uuid
  activityId          String              @db.Uuid
  membershipId        String              @db.Uuid
  choir               Choir               @relation(fields: [choirId], references: [id], onDelete: Cascade)
  activity            Activity            @relation(fields: [activityId], references: [id], onDelete: Cascade)
  membership          Membership          @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  arrivedAt           DateTime?
  leftAt              DateTime?
  status              AttendanceStatus    @default(ABSENT)
  participationStatus ParticipationStatus @default(PENDING)
  minutesLate         Int                 @default(0)
  durationMinutes     Int?
  voiceSectionId      String?             @db.Uuid
  scans               AttendanceScan[]
  justifications      Justification[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([activityId, membershipId])
  @@index([choirId, activityId])
  @@map("attendances")
}

model AttendanceQrToken {
  id           String             @id @default(uuid()) @db.Uuid
  choirId      String             @db.Uuid
  activityId   String             @db.Uuid
  membershipId String             @db.Uuid
  tokenHash    String             @unique
  scanType     AttendanceScanType
  expiresAt    DateTime
  consumedAt   DateTime?
  activity     Activity           @relation(fields: [activityId], references: [id], onDelete: Cascade)
  membership   Membership         @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  scan         AttendanceScan?
  createdAt    DateTime           @default(now())

  @@index([choirId, activityId, membershipId])
  @@map("attendance_qr_tokens")
}

model AttendanceScan {
  id           String             @id @default(uuid()) @db.Uuid
  attendanceId String             @db.Uuid
  qrTokenId    String             @unique @db.Uuid
  scanType     AttendanceScanType
  scannedById  String             @db.Uuid
  deviceId     String?
  scannedAt    DateTime           @default(now())
  attendance   Attendance         @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  qrToken      AttendanceQrToken  @relation(fields: [qrTokenId], references: [id], onDelete: Restrict)
  scannedBy    Membership         @relation("AttendanceScanner", fields: [scannedById], references: [id], onDelete: Restrict)

  @@index([attendanceId, scannedAt])
  @@map("attendance_scans")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  choirId       String   @db.Uuid
  actorUserId   String   @db.Uuid
  action        String
  entityType    String
  entityId      String
  reason        String?
  before        Json?
  after         Json?
  correlationId String?
  createdAt     DateTime @default(now())
  choir         Choir    @relation(fields: [choirId], references: [id], onDelete: Cascade)

  @@index([choirId, entityType, entityId])
  @@map("audit_logs")
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  platform  String
  active    Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, active])
  @@map("device_tokens")
}

model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  choirId   String              @db.Uuid
  name      String
  trigger   NotificationTrigger
  channel   NotificationChannel
  title     String
  body      String
  rules     Json                @default("{}")
  enabled   Boolean             @default(true)
  version   Int                 @default(1)
  choir     Choir               @relation(fields: [choirId], references: [id], onDelete: Cascade)
  jobs      NotificationJob[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([choirId, name, channel])
  @@map("notification_templates")
}

model NotificationJob {
  id             String                @id @default(uuid()) @db.Uuid
  choirId        String                @db.Uuid
  templateId     String?               @db.Uuid
  membershipId   String                @db.Uuid
  activityId     String?               @db.Uuid
  channel        NotificationChannel
  trigger        NotificationTrigger
  titleSnapshot  String
  bodySnapshot   String
  scheduledAt    DateTime
  status         NotificationJobStatus @default(QUEUED)
  idempotencyKey String                @unique
  sentAt         DateTime?
  failedAt       DateTime?
  failureReason  String?
  choir          Choir                 @relation(fields: [choirId], references: [id], onDelete: Cascade)
  template       NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  membership     Membership            @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  activity       Activity?             @relation(fields: [activityId], references: [id], onDelete: Cascade)
  inApp          InAppNotification?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status, scheduledAt])
  @@index([choirId, membershipId])
  @@map("notification_jobs")
}

model InAppNotification {
  id           String          @id @default(uuid()) @db.Uuid
  jobId        String          @unique @db.Uuid
  membershipId String          @db.Uuid
  title        String
  body         String
  readAt       DateTime?
  job          NotificationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  membership   Membership      @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())

  @@index([membershipId, readAt, createdAt])
  @@map("in_app_notifications")
}

model FinanceFund {
  id             String                @id @default(uuid()) @db.Uuid
  choirId        String                @db.Uuid
  choir          Choir                 @relation(fields: [choirId], references: [id], onDelete: Cascade)
  name           String
  type           FinanceFundType       @default(ORDINARY)
  currency       CurrencyCode
  initialBalance Decimal               @default(0) @db.Decimal(14, 2)
  status         EntityStatus          @default(ACTIVE)
  contributions  Contribution[]
  payments       ContributionPayment[]
  incomes        FinanceIncome[]
  expenses       FinanceExpense[]
  movements      FinanceMovement[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([choirId, name, currency])
  @@index([choirId, currency])
  @@map("finance_funds")
}

model Contribution {
  id          String                       @id @default(uuid()) @db.Uuid
  choirId     String                       @db.Uuid
  choir       Choir                        @relation(fields: [choirId], references: [id], onDelete: Cascade)
  fundId      String                       @db.Uuid
  fund        FinanceFund                  @relation(fields: [fundId], references: [id], onDelete: Restrict)
  title       String
  description String?
  amount      Decimal                      @db.Decimal(14, 2)
  currency    CurrencyCode
  frequency   FinanceContributionFrequency @default(ONCE)
  dueDate     DateTime                     @db.Date
  targetType  FinanceTargetType            @default(ALL_MEMBERS)
  status      EntityStatus                 @default(ACTIVE)
  targets     ContributionTarget[]
  obligations ContributionObligation[]
  payments    ContributionPayment[]
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  @@index([choirId, dueDate])
  @@index([fundId])
  @@map("contributions")
}

model ContributionTarget {
  id             String        @id @default(uuid()) @db.Uuid
  contributionId String        @db.Uuid
  contribution   Contribution  @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  membershipId   String?       @db.Uuid
  membership     Membership?   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  voiceSectionId String?       @db.Uuid
  voiceSection   VoiceSection? @relation(fields: [voiceSectionId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@unique([contributionId, membershipId])
  @@unique([contributionId, voiceSectionId])
  @@index([membershipId])
  @@index([voiceSectionId])
  @@map("contribution_targets")
}

model ContributionObligation {
  id                 String                @id @default(uuid()) @db.Uuid
  choirId            String                @db.Uuid
  choir              Choir                 @relation(fields: [choirId], references: [id], onDelete: Cascade)
  contributionId     String                @db.Uuid
  contribution       Contribution          @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  membershipId       String                @db.Uuid
  membership         Membership            @relation(fields: [membershipId], references: [id], onDelete: Cascade)
